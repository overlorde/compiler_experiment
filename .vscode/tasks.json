{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "make",
            "type": "shell",
            "command": "make",
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"],
            "options": { "cwd": "${workspaceFolder}" },
            "presentation": { "reveal": "silent", "panel": "shared" }
        },
        {
            "label": "make clean",
            "type": "shell",
            "command": "make clean",
            "options": { "cwd": "${workspaceFolder}" }
        },
        {
            "label": "make test",
            "type": "shell",
            "command": "make test",
            "group": { "kind": "test", "isDefault": true },
            "options": { "cwd": "${workspaceFolder}" }
        },
        {
            // Regenerate compile_commands.json so clangd sees flag changes.
            "label": "bear: regenerate compile_commands.json",
            "type": "shell",
            "command": "make clean && bear -- make",
            "options": { "cwd": "${workspaceFolder}" }
        }
    ]
}
